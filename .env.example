# Base PostgreSQL de démonstration (cible des requêtes de l'agent)
DB_URL=postgresql+psycopg://sorabel:sorabel@localhost:5433/sorabel

# Rôle en lecture seule utilisé par l'agent (créé par `make roles`)
AGENT_DB_URL=postgresql+psycopg://sorabel_agent:sorabel_agent@localhost:5433/sorabel

# Sources externes simulées (mock HTTP, cf. docker-compose)
SOURCE_ONE_BASE_URL=http://localhost:8011
SOURCE_TWO_BASE_URL=http://localhost:8012

# Modèle Kimi-K2.6 hébergé sur Azure AI Foundry
AZURE_AI_INFERENCE_ENDPOINT=
AZURE_AI_INFERENCE_API_KEY=
AZURE_AI_INFERENCE_MODEL=Kimi-K2.6

LOG_LEVEL=INFO
